<</Type /Annot /Subtype /Link /Rect [79.35 113.63 9303.58 101.02] /Border [0 0 0] /A <</S /URI /URI (https://learn.ethereallab.app/assignment/v3/IT202-007-F2025/%3C?php%20require_once(__DIR__%20.%20%22/../../partials/nav.php%22);%20if%20(!is_logged_in())%20{%20%20%20%20%20die(header(%22Location:%20login.php%22));%20}%20?%3E%20%3C?php%20$user_id%20=%20get_user_id();%20//%20get%20id%20from%20session%20$email%20=%20get_user_email();%20//%20get%20email%20from%20session%20$username%20=%20get_username();%20//%20get%20username%20from%20session%20//%20handle%20email/username%20update%20if%20(isset($_POST[%22email%22],%20$_POST[%22username%22]))%20{%20%20%20%20%20$new_email%20=%20se($_POST,%20%22email%22,%20null,%20false);%20%20%20%20%20$new_username%20=%20se($_POST,%20%22username%22,%20null,%20false);%20%20%20%20%20$hasError%20=%20false;%20%20%20%20%20//%20validate%20format%20%20%20%20%20if%20(empty($new_email))%20{%20%20%20%20%20%20%20%20%20//echo%20%22Email%20must%20not%20be%20empty%3Cbr%3E%22;%20%20%20%20%20%20%20%20%20flash(%22Email%20must%20not%20be%20empty.%22,%20%22danger%22);%20%20%20%20%20%20%20%20%20$hasError%20=%20true;%20%20%20%20%20}%20%20%20%20%20//%20Sanitize%20and%20validate%20email%20%20%20%20%20$new_email%20=%20sanitize_email($new_email);%20%20%20%20%20if%20(!is_valid_email($new_email))%20{%20%20%20%20%20%20%20%20%20//echo%20%22Invalid%20email%20address%3Cbr%3E%22;%20%20%20%20%20%20%20%20%20flash(%22Invalid%20email%20address.%22,%20%22danger%22);%20%20%20%20%20%20%20%20%20$hasError%20=%20true;%20%20%20%20%20}%20%20%20%20%20if%20(!is_valid_username($new_username))%20{%20%20%20%20%20%20%20%20%20flash(%22Username%20must%20be%20lowercase,%20alphanumerical,%20and%20can%20only%20contain%20_%20or%20-%22,%20%22danger%22);%20%20%20%20%20%20%20%20%20$hasError%20=%20true;%20%20%20%20%20}%20%20%20%20%20//%20check%20for%20changes%20%20%20%20%20if%20(($username%20!=%20$new_username%20||%20$email%20!=%20$new_email)%20&&%20!$hasError)%20{%20%20%20%20%20%20%20%20%20$saved%20=%20false;%20%20%20%20%20%20%20%20%20$params%20=%20[%22:email%22%20=%3E%20$new_email,%20%22:username%22%20=%3E%20$new_username,%20%22:id%22%20=%3E%20$user_id];%20%20%20%20%20%20%20%20%20$db%20=%20getDB();%20%20%20%20%20%20%20%20%20$stmt%20=%20$db-%3Eprepare(%22UPDATE%20Users%20set%20email%20=%20:email,%20username%20=%20:username%20where%20id%20=%20:id%22);%20%20%20%20%20%20%20%20%20try%20{%20%20%20%20%20%20%20%20%20%20%20%20%20$stmt-%3Eexecute($params);%20%20%20%20%20%20%20%20%20%20%20%20%20$updated_rows%20=%20$stmt-%3ErowCount();%20%20%20%20%20%20%20%20%20%20%20%20%20if%20($updated_rows%20===%200)%20{%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20flash(%22No%20changes%20made%22,%20%22warning%22);%20%20%20%20%20%20%20%20%20%20%20%20%20}%20else%20if%20($updated_rows%20==%201)%20{%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20flash(%22Profile%20saved%22,%20%22success%22);%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20$saved%20=%20true;%20%20%20%20%20%20%20%20%20%20%20%20%20}%20else%20{%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20//%20this%20shouldn%27t%20happen,%20but%20we%20log%20it%20just%20in%20case%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20error_log(%22Unexpected%20number%20of%20rows%20updated:%20%22%20.%20$updated_rows);%20%20%20%20%20%20%20%20%20%20%20%20%20}%20%20%20%20%20%20%20%20%20}%20catch%20(PDOException%20$e)%20{%20%20%20%20%20%20%20%20%20%20%20%20%20//%20handle%20existing%20email/username%20error%20%20%20%20%20%20%20%20%20%20%20%20%20users_check_duplicate($e);%20%20%20%20%20%20%20%20%20}%20catch%20(Exception%20$e)%20{%20%20%20%20%20%20%20%20%20%20%20%20%20flash(%22An%20unexpected%20error%20occurred,%20please%20try%20again%22,%20%22danger%22);%20%20%20%20%20%20%20%20%20%20%20%20%20error_log(%22Unexpected%20Error%20updating%20user%20details:%20%22%20.%20var_export($e,%20true));%20%20%20%20%20%20%20%20%20}%20%20%20%20%20%20%20%20%20if%20($saved)%20{%20%20%20%20%20%20%20%20%20%20%20%20%20//select%20fresh%20data%20from%20table%20%20%20%20%20%20%20%20%20%20%20%20%20$stmt%20=%20$db-%3Eprepare(%22SELECT%20email,%20username%20from%20Users%20where%20id%20=%20:id%20LIMIT%201%22);%20%20%20%20%20%20%20%20%20%20%20%20%20try%20{%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20$stmt-%3Eexecute([%22:id%22%20=%3E%20$user_id]);%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20$user%20=%20$stmt-%3Efetch(PDO::FETCH_ASSOC);%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20if%20($user)%20{%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20//$_SESSION[%22user%22]%20=%20$user;%20//%20don%27t%20overwrite%20the%20entire%20session%20data,%20just%20update%20the%20specific%20fields%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20$_SESSION[%22user%22][%22email%22]%20=%20$user[%22email%22];%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20$_SESSION[%22user%22][%22username%22]%20=%20$user[%22username%22];%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20//%20since%20this%20comes%20after%20the%20setting%20of%20$username%20and%20$email%20at%20the%20top,%20we%27ll%20apply%20the%20edits%20to%20them%20too%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20$username%20=%20$user[%22username%22];%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20$email%20=%20$user[%22email%22];%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20}%20else%20{%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20//%20This%20shouldn%27t%20happen,%20but%20we%20add%20logs/notification%20just%20in%20case%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20flash(%22User%20doesn%27t%20exist%22,%20%22danger%22);%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20error_log(%22User%20doesn%27t%20exist%22);%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20}%20%20%20%20%20%20%20%20%20%20%20%20%20}%20catch%20(PDOException%20$e)%20{%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20flash(%22An%20unexpected%20error%20occurred,%20please%20try%20again%22,%